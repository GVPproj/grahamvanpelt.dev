---
// PROTOTYPE — throwaway. Four mobile-nav variants, switchable via
// `?variant=a|b|c|d` (and ← / → keys) from the floating bar at the bottom.
// Mounted from Layout.astro only when `import.meta.env.DEV`, so it can never
// ship. It re-points the existing hamburger's popovertarget at whichever
// variant is active; the production #site-nav popover is left unreferenced.
//
// Question: should the mobile menu entries be pill buttons like the desktop
// header, or something else?
//   a  Pill stack      — full-screen, every entry a frosted pill (desktop pill echo)
//   b  Bottom sheet    — slides up from the bottom, list rows with dividers
//   c  Anchored card   — small frosted dropdown under the hamburger, like a desktop menu
//   d  Editorial       — full-screen, huge numbered serif type, sig in the footer
import Sig from '../Sig.astro'
import Github from '../icons/Github.astro'

const path = Astro.url.pathname

const links = [
  { href: '/cv', label: 'CV', match: (p: string) => p.startsWith('/cv') },
  {
    href: '/portfolio',
    label: 'Portfolio',
    match: (p: string) => p === '/portfolio',
  },
  { href: '/blog', label: 'Blog', match: (p: string) => p.startsWith('/blog') },
]

const variants = [
  { key: 'a', name: 'Pill stack' },
  { key: 'b', name: 'Bottom sheet' },
  { key: 'c', name: 'Anchored card' },
  { key: 'd', name: 'Editorial' },
]
---

<!-- ===================================================== A: pill stack -- -->
<nav popover id="proto-nav-a" class="proto proto-a">
  <div class="top">
    <a href="/" aria-label="Go back to the homepage" class:list={['home', { current: path === '/' }]}>
      <Sig persist={false} />
    </a>
    <button type="button" popovertarget="proto-nav-a" popovertargetaction="hide" class="close-pill" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} class:list={['pill', { current: link.match(path) }]}>
          <span>{link.label}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
    <li>
      <a href="https://github.com/GVPproj" target="_blank" rel="noopener noreferrer" class="pill pill-gh">
        <span class="gh"><Github width="22" height="22" /> GitHub</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
</nav>

<!-- =================================================== B: bottom sheet -- -->
<nav popover id="proto-nav-b" class="proto proto-b">
  <div class="handle" aria-hidden="true"></div>
  <ul>
    <li>
      <a href="/" class:list={['row', { current: path === '/' }]}>
        <span>Home</span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
    </li>
    {links.map((link) => (
      <li>
        <a href={link.href} class:list={['row', { current: link.match(path) }]}>
          <span>{link.label}</span>
          <span class="chev" aria-hidden="true">›</span>
        </a>
      </li>
    ))}
    <li>
      <a href="https://github.com/GVPproj" target="_blank" rel="noopener noreferrer" class="row row-gh">
        <span class="gh"><Github width="22" height="22" /> GitHub</span>
        <span class="chev" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
  <button type="button" popovertarget="proto-nav-b" popovertargetaction="hide" class="sheet-close">
    Close
  </button>
</nav>

<!-- ================================================== C: anchored card -- -->
<nav popover id="proto-nav-c" class="proto proto-c">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} class:list={['item', { current: link.match(path) }]}>{link.label}</a>
      </li>
    ))}
    <li class="divider" aria-hidden="true"></li>
    <li>
      <a href="https://github.com/GVPproj" target="_blank" rel="noopener noreferrer" class="item item-gh">
        <Github width="20" height="20" /> GitHub <span class="ext" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
</nav>

<!-- ====================================================== D: editorial -- -->
<nav popover id="proto-nav-d" class="proto proto-d">
  <div class="top">
    <span class="kicker">Menu</span>
    <button type="button" popovertarget="proto-nav-d" popovertargetaction="hide" class="close-plain" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <ul>
    {links.map((link, i) => (
      <li style={`--i: ${i}`}>
        <a href={link.href} class:list={['big', { current: link.match(path) }]}>
          <span class="num">0{i + 1}</span>
          <span class="word">{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="foot">
    <a href="/" aria-label="Go back to the homepage" class:list={['home', { current: path === '/' }]}>
      <Sig persist={false} />
    </a>
    <a href="https://github.com/GVPproj" target="_blank" rel="noopener noreferrer" class="gh-chip" aria-label="Visit my GitHub profile">
      <Github width="22" height="22" />
    </a>
  </div>
</nav>

<!-- ============================================ floating variant switcher -- -->
<div popover="manual" id="proto-switcher" class="switcher" data-variants={variants.map((v) => v.key).join(',')}>
  <button type="button" data-dir="-1" aria-label="Previous variant">‹</button>
  <span class="label">
    <b data-key></b> <span data-name></span>
  </span>
  <button type="button" data-dir="1" aria-label="Next variant">›</button>
  <template>
    {variants.map((v) => <span data-key={v.key}>{v.name}</span>)}
  </template>
</div>

<script>
  function setup() {
    const switcherEl = document.querySelector<HTMLElement>('#proto-switcher')
    const toggleEl = document.querySelector<HTMLButtonElement>('button.menu-toggle')
    if (!switcherEl || !toggleEl) return
    const switcher = switcherEl
    const toggle = toggleEl

    const keys = (switcher.dataset.variants ?? '').split(',')
    const names: Record<string, string> = {}
    switcher
      .querySelector('template')!
      .content.querySelectorAll<HTMLElement>('[data-key]')
      .forEach((el) => (names[el.dataset.key!] = el.textContent ?? ''))

    const fromUrl = new URLSearchParams(location.search).get('variant')
    let current =
      (fromUrl && keys.includes(fromUrl) && fromUrl) ||
      sessionStorage.getItem('proto-variant') ||
      keys[0]

    function navFor(key: string) {
      return document.querySelector<HTMLElement>(`#proto-nav-${key}`)
    }

    function apply(key: string, { reopen = false } = {}) {
      const prev = navFor(current)
      const wasOpen = prev?.matches(':popover-open') ?? false
      if (wasOpen) prev!.hidePopover()

      current = key
      sessionStorage.setItem('proto-variant', key)
      document.documentElement.dataset.protoVariant = key
      toggle.setAttribute('popovertarget', `proto-nav-${key}`)
      switcher.querySelector('[data-key]')!.textContent = key.toUpperCase()
      switcher.querySelector('[data-name]')!.textContent = `(${names[key]})`

      const url = new URL(location.href)
      url.searchParams.set('variant', key)
      history.replaceState(history.state, '', url)

      if (reopen && wasOpen) navFor(key)?.showPopover()
    }

    function cycle(dir: number) {
      const i = keys.indexOf(current)
      apply(keys[(i + dir + keys.length) % keys.length], { reopen: true })
    }

    switcher.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () => cycle(Number(b.dataset.dir))),
    )

    // Keep the switcher on top of the top layer: re-show it whenever a nav
    // opens so it's still reachable with a full-screen menu up.
    keys.forEach((k) =>
      navFor(k)?.addEventListener('toggle', (e) => {
        if ((e as ToggleEvent).newState === 'open') {
          switcher.hidePopover()
          switcher.showPopover()
        }
      }),
    )

    apply(current)
    switcher.showPopover()
  }

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null
    if (t && (t.matches('input, textarea') || t.isContentEditable)) return
    if (e.key === 'ArrowLeft') document.querySelector<HTMLButtonElement>('#proto-switcher [data-dir="-1"]')?.click()
    if (e.key === 'ArrowRight') document.querySelector<HTMLButtonElement>('#proto-switcher [data-dir="1"]')?.click()
  })

  document.addEventListener('astro:before-preparation', () => {
    document.querySelectorAll<HTMLElement>('.proto').forEach((n) => n.hidePopover())
  })

  setup()
  document.addEventListener('astro:page-load', setup)
</script>

<style>
  /* ------------------------------------------------------------ shared -- */
  .proto {
    border: 0;
    margin: 0;
    background-color: var(--colour-fill);
    color: var(--colour-text-base);
    font-family: var(--font-sans);
    opacity: 0;
    transition:
      opacity 0.2s ease-out,
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      overlay 0.25s ease-out allow-discrete,
      display 0.25s ease-out allow-discrete;
  }

  .proto:popover-open {
    opacity: 1;
  }

  @media (width >= 48rem) {
    .proto,
    .switcher {
      display: none !important;
    }
  }

  .home {
    color: var(--colour-text-base);
  }

  .home.current {
    color: var(--colour-accent);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  /* --------------------------------------------------- A: pill stack -- */
  .proto-a {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 1.5rem;
  }

  @starting-style {
    .proto-a:popover-open {
      opacity: 0;
    }
  }

  .proto-a .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .close-pill {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--ink-700);
    border-radius: 999px;
    background: color-mix(in srgb, var(--colour-fill-muted) 70%, transparent);
    cursor: pointer;
  }

  .proto-a ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block-start: 3rem;
  }

  .proto-a li {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .proto-a:popover-open li {
    opacity: 1;
    transform: none;
  }

  .proto-a li:nth-child(1) { transition-delay: 40ms; }
  .proto-a li:nth-child(2) { transition-delay: 90ms; }
  .proto-a li:nth-child(3) { transition-delay: 140ms; }
  .proto-a li:nth-child(4) { transition-delay: 190ms; }

  .pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 1.625rem;
    border: 1px solid var(--ink-700);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--colour-fill-muted) 55%, transparent);
    backdrop-filter: blur(12px);
    color: var(--colour-text-base);
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 500;
    box-shadow: 0 10px 30px -18px hsl(204 80% 6% / 0.8);
  }

  .pill:active {
    background-color: var(--colour-fill-muted);
    border-color: var(--ink-500);
  }

  .pill.current {
    border-color: var(--colour-accent);
    color: var(--colour-accent);
  }

  .pill .arrow {
    color: var(--ink-300);
    font-size: 1.125rem;
  }

  .pill.current .arrow {
    color: inherit;
  }

  /* ------------------------------------------------- B: bottom sheet -- */
  .proto-b {
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: 85dvh;
    padding: 0.75rem 1.5rem 2.25rem;
    border-block-start: 1px solid var(--ink-500);
    border-radius: 1.5rem 1.5rem 0 0;
    background-color: color-mix(in srgb, var(--colour-fill) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 -20px 50px -20px hsl(204 80% 4% / 0.9);
    transform: translateY(100%);
  }

  .proto-b:popover-open {
    transform: none;
  }

  @starting-style {
    .proto-b:popover-open {
      opacity: 0;
      transform: translateY(100%);
    }
  }

  .proto-b::backdrop {
    background: hsl(204 80% 6% / 0.55);
    transition: background 0.25s ease-out;
  }

  @starting-style {
    .proto-b:popover-open::backdrop {
      background: transparent;
    }
  }

  .handle {
    width: 2.5rem;
    height: 0.25rem;
    margin: 0 auto 1rem;
    border-radius: 999px;
    background: var(--ink-500);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0.25rem;
    border-block-end: 1px solid var(--ink-700);
    color: var(--colour-text-base);
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 500;
  }

  .row.current {
    color: var(--colour-accent);
  }

  .row:active {
    color: var(--colour-highlight);
  }

  .row .chev {
    color: var(--ink-300);
    font-size: 1.5rem;
    line-height: 1;
  }

  .row-gh {
    border-block-end: 0;
  }

  .sheet-close {
    display: block;
    width: 100%;
    margin-block-start: 1rem;
    padding: 0.875rem;
    border: 1px solid var(--ink-700);
    border-radius: 999px;
    background: var(--colour-fill-muted);
    color: var(--colour-text-muted);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
  }

  /* ------------------------------------------------ C: anchored card -- */
  .proto-c {
    inset: 4.75rem 1.25rem auto auto;
    width: min(17rem, calc(100% - 2.5rem));
    padding: 0.5rem;
    border: 1px solid var(--ink-500);
    border-radius: 1.25rem;
    background-color: color-mix(in srgb, var(--colour-fill) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 20px 40px -14px hsl(204 80% 4% / 0.9);
    transform-origin: top right;
    transform: scale(0.92) translateY(-0.25rem);
  }

  .proto-c:popover-open {
    transform: none;
  }

  @starting-style {
    .proto-c:popover-open {
      opacity: 0;
      transform: scale(0.92) translateY(-0.25rem);
    }
  }

  .proto-c::backdrop {
    background: transparent;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.8125rem 1rem;
    border-radius: 0.875rem;
    color: var(--colour-text-base);
    font-size: 1.125rem;
    line-height: 1.5rem;
    font-weight: 500;
  }

  .item:active {
    background: var(--colour-fill-muted);
  }

  .item.current {
    background: var(--colour-fill-muted);
    color: var(--colour-accent);
  }

  .item .ext {
    margin-inline-start: auto;
    color: var(--ink-300);
  }

  .divider {
    height: 1px;
    margin: 0.375rem 0.75rem;
    background: var(--ink-700);
  }

  /* --------------------------------------------------- D: editorial -- */
  /* No bare `display: flex` here: it would override the UA's closed-state
     display: none and leave the panel permanently visible. */
  .proto-d {
    flex-direction: column;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 1.5rem;
  }

  .proto-d:popover-open {
    display: flex;
  }

  @starting-style {
    .proto-d:popover-open {
      opacity: 0;
    }
  }

  .proto-d .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
  }

  .kicker {
    color: var(--ink-300);
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .close-plain {
    padding-inline: 0.375rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .proto-d ul {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
  }

  .proto-d li {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(60ms + var(--i) * 70ms);
  }

  .proto-d:popover-open li {
    opacity: 1;
    transform: none;
  }

  .big {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.75rem;
    border-block-end: 1px solid var(--ink-700);
    color: var(--colour-text-base);
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 12vw, 3.75rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .big .num {
    color: var(--colour-accent);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .big.current .word {
    color: var(--colour-accent);
  }

  .big:active .word {
    color: var(--colour-highlight);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-start: 1.5rem;
  }

  .gh-chip {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--ink-500);
    border-radius: 999px;
    color: var(--colour-text-base);
  }

  /* ---------------------------------------------------- switcher bar -- */
  /* Deliberately alien to the site: it is not part of the design under
     review. */
  .switcher {
    position: fixed;
    inset: auto auto 0.75rem 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.375rem 0.5rem;
    border: 2px solid #facc15;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font: 600 0.8125rem/1 ui-monospace, monospace;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.5);
  }

  .switcher button {
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 999px;
    background: #333;
    color: #fff;
    font-size: 1.125rem;
    line-height: 1;
    cursor: pointer;
  }

  .switcher .label {
    min-width: 9rem;
    text-align: center;
  }

  .switcher b {
    color: #facc15;
  }
</style>
