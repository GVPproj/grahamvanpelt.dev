---
import type { CollectionEntry } from 'astro:content'
import Layout from './Layout.astro'
import { formatPostDate } from '../data/blog'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, created } = post.data
---

<Layout
  title={`${title} - Graham Van Pelt`}
  description={description}
  image={`/og/${post.id}.png`}
  publishedTime={created}
>
  <article>
    <header>
      <h1>{title}</h1>
      <time datetime={created.toISOString()}>{formatPostDate(created)}</time>
    </header>
    <div class="prose"><slot /></div>
  </article>
</Layout>

<script>
  // The button is injected rather than server-rendered so no-JS visitors never
  // see a dead control, and the navigator.clipboard guard covers insecure
  // contexts (plain-HTTP dev over LAN) the same way.
  //
  // If <ClientRouter /> is ever added to this site, this loop must move into an
  // `astro:page-load` listener or the buttons stop appearing after the first
  // client-side navigation.
  if (navigator.clipboard) {
    for (const pre of document.querySelectorAll('pre.astro-code')) {
      // .code-block is the positioning context, not decoration: .prose pre has
      // overflow-x: auto, so a button positioned inside the <pre> would scroll
      // out of view on a long line.
      const wrapper = document.createElement('div')
      wrapper.className = 'code-block'
      pre.parentNode?.insertBefore(wrapper, pre)
      wrapper.append(pre)

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'copy-code'
      button.textContent = 'Copy'
      wrapper.append(button)

      let timer: ReturnType<typeof setTimeout>
      button.addEventListener('click', async () => {
        try {
          // textContent, not innerText: Shiki emits one <span class="line"> per
          // line with real newlines between them, so textContent reproduces the
          // source exactly. innerText is layout-aware and would follow the CSS.
          await navigator.clipboard.writeText(
            pre.querySelector('code')?.textContent ?? '',
          )
          button.textContent = 'Copied'
          button.dataset.copied = ''
          clearTimeout(timer)
          timer = setTimeout(() => {
            button.textContent = 'Copy'
            delete button.dataset.copied
          }, 2000)
        } catch {
          button.textContent = 'Press ⌘C'
        }
      })
    }
  }
</script>

<style>
  article {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  header {
    width: 100%;
    max-width: 65ch;
    margin-inline: auto;
  }

  h1 {
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 700;
    color: var(--colour-accent);
  }

  time {
    display: block;
    margin-block-start: 1rem;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: var(--colour-accent);
  }
</style>
