---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import BaseHead from '../components/BaseHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
// PROTOTYPE: dev-only mobile nav variants, see components/prototype/.
import MobileNavPrototype from '../components/prototype/MobileNavPrototype.astro'

interface Props {
  title: string
  description: string
  image?: string
  publishedTime?: Date
  noindex?: boolean
}
---

<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
    <ClientRouter />
  </head>
  <body>
    <!-- SiteHeader is sticky on desktop; it must stay a direct child of body
         (the scroll container) or a wrapper becomes its containing block. -->
    <SiteHeader />
    <main class="wrapper"><slot /></main>
    <SiteFooter />
    {import.meta.env.DEV && <MobileNavPrototype />}
  </body>
</html>
